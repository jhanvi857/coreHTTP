# NioFlow Database Configuration
NIOFLOW_ENABLE_DB=false
JDBC_URL=jdbc:postgresql://your-db-host:5432/postgres
DB_USER=postgres
DB_PASS=your-secret-password
MONGO_URI=

# Framework settings
PORT=8080
LOG_LEVEL=INFO
JWT_SECRET=replace-with-32-plus-char-secret
NIOFLOW_CORS_ORIGIN=http://localhost:3000
NIOFLOW_DISABLE_AUTH=false

# Runtime tuning
NIOFLOW_THREADS=64
NIOFLOW_QUEUE_CAPACITY=1000
NIOFLOW_SOCKET_TIMEOUT_MS=30000

# Optional TLS
NIOFLOW_TLS_ENABLED=false
NIOFLOW_TLS_KEYSTORE_PATH=
NIOFLOW_TLS_KEYSTORE_PASSWORD=
NIOFLOW_TLS_PORT=8443

# Diagnostics
NIOFLOW_EXPOSE_ERROR_DETAILS=false
NIOFLOW_STATIC_DIR=

# Experimental/advanced features (opt-in)
NIOFLOW_CHAOS_ENABLED=false
NIOFLOW_REPLAY_ENABLED=false
